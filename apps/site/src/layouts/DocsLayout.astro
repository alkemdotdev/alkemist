---
import SiteLayout from './SiteLayout.astro';
import DocsNav from '../components/DocsNav.astro';
import { isPreview } from '../lib/deployment';
import '../styles/docs.css';

interface Props {
  title: string;
  description: string;
  headings?: { depth: number; slug: string; text: string }[];
  catalog?: boolean;
}
const { title, description, headings = [], catalog = false } = Astro.props;
const sections = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 4,
);
---

<SiteLayout title={title} description={description} preview={isPreview}>
  <div class="docs-shell">
    <DocsNav headings={sections} />
    <article
      class:list={['docs-article', 'alk-prose', { 'docs-catalog': catalog }]}
    >
      <header class="docs-heading">
        <h1>{title}</h1>
        <p class="docs-description">{description}</p>
      </header>
      <slot />
    </article>
  </div>
</SiteLayout>
