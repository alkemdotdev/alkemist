---
import SiteLayout from '../layouts/SiteLayout.astro';
import { isPreview } from '../lib/deployment';
import StartUsing from '../components/StartUsing.astro';
import FluxHero from '../components/FluxHero.astro';
---

<SiteLayout
  title="Alkemist"
  description="An Astro starting point for inventors and researchers. Publish your notes, code, data, and interactive models in a website you can make your own."
  preview={isPreview}
>
  <FluxHero />
  <section class="home-tools" aria-label="Inside the toolkit">
    <a href="/docs/math-code/">
      <h2>Math and code <span aria-hidden="true">→</span></h2>
      <p>Typeset equations and publish code with syntax highlighting.</p>
    </a>
    <a href="/docs/charts/">
      <h2>Charts <span aria-hidden="true">→</span></h2>
      <p>Plot CSV data as line, bar, scatter, and pie charts.</p>
    </a>
    <a href="/docs/models/">
      <h2>3D models <span aria-hidden="true">→</span></h2>
      <p>Embed models readers can rotate, zoom, and inspect.</p>
    </a>
  </section>
  <StartUsing />
  <section class="home-notebook" aria-labelledby="notebook-title">
    <div>
      <h2 id="notebook-title">How this site works</h2>
      <a href="/blog/">All articles <span aria-hidden="true">→</span></a>
    </div>
    <div class="home-notebook-links">
      <a href="/blog/home-for-working-ideas/"
        ><strong>Building the homepage</strong><span aria-hidden="true">↗</span
        ></a
      >
      <a href="/labs/"
        ><strong>Experiments</strong><span aria-hidden="true">↗</span></a
      >
      <a href="/book/"
        ><strong>Start with the book</strong><span aria-hidden="true">↗</span
        ></a
      >
    </div>
  </section>
</SiteLayout>

<style>
  .home-tools {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    padding: 2rem 0 0;
    border-top: 1px solid var(--alk-rule);
  }
  .home-tools > a {
    color: inherit;
    text-decoration: none;
  }
  .home-tools h2 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.55rem;
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.025em;
  }
  .home-tools p {
    max-width: 34ch;
    margin: 0;
    color: var(--alk-muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }
  .home-tools h2 span {
    color: var(--alk-muted);
    font: 0.85rem var(--alk-mono);
  }
  .home-tools a:hover h2 {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .home-notebook {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--alk-rule);
  }
  .home-notebook h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    line-height: 1.12;
    letter-spacing: -0.04em;
    max-width: 20ch;
    margin: 0 0 1rem;
  }
  .home-notebook > div > a {
    font-size: 0.85rem;
  }
  .home-notebook-links a {
    display: grid;
    grid-template-columns: 1fr auto;
    padding: 1rem 0;
    border-bottom: 1px solid var(--alk-rule);
    text-decoration: none;
  }
  .home-notebook-links a:first-child {
    padding-top: 0;
  }
  .home-notebook-links a > span {
    color: var(--alk-muted);
    font: 0.85rem/1.5 var(--alk-mono);
  }
  .home-notebook-links strong {
    font-size: 1rem;
    font-weight: 400;
  }
  .home-notebook-links a:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  @media (max-width: 700px) {
    .home-tools {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-top: 1.5rem;
    }
    .home-tools h2 {
      font-size: 1.1rem;
    }
    .home-tools p {
      max-width: 34ch;
      font-size: 0.88rem;
    }
    .home-notebook {
      grid-template-columns: 1fr;
      gap: 2.2rem;
      margin-top: 3rem;
      padding-top: 2rem;
    }
  }
</style>
