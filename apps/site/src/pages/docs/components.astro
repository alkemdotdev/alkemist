---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { groups } from '../../lib/playground/definitions';
---

<DocsLayout
  title="Components"
  description="From a paragraph to a complete website. Four groups, one component package."
>
  <p>
    Start with the content you want to publish. Each group has working examples
    with editable parameters, a live preview, and copyable source.
  </p>
  <p>
    See the same components in a plain host page in the
    <a href="/labs/embeds/">component embed lab</a>.
  </p>
  <div class="docs-directory">
    {
      groups.map((group) => (
        <section>
          <>
            <h2>
              <a href={`/docs/${group.id}/`}>{group.title} →</a>
            </h2>
            <p>{group.description}</p>
            <p class="docs-footnote">
              {group.id === 'content'
                ? 'Math · code · audio · video'
                : group.id === 'visualization'
                  ? 'Charts · MIDI · piano roll'
                  : group.id === 'graphics'
                    ? '3D models · shaders'
                    : 'Layout · navigation · contents · post lists · search'}
            </p>
          </>
        </section>
      ))
    }
  </div>
  <p>
    <a href="/docs/parameters/">Live parameters</a>, <a href="/docs/focus/"
      >figure focus</a
    >, and <a href="/docs/themes/">shared themes</a> work across documents and slides.
    <a href="/labs/themes-and-parameters/">Try them together</a>.
  </p>
  <h2>Use one component</h2>
  <p>
    All components live in <code>@alkemdotdev/alkemist-components</code>, with
    direct imports such as <code>/chart</code> and <code>/navigation</code>.
    These categories organize the documentation; they do not change package
    boundaries.
  </p>
  <p>
    <a href="/docs/#add-one-component">Install in an existing Astro site →</a>
  </p>
  <h2>Explore an example</h2>
  <p>
    <a href="/docs/slides/">Presentations, decks, and steps</a> bring these same components
    into Markdown-authored <a href="/slides/">browser presentations</a>.
  </p>
  <p>
    <a href="/docs/annotations/">Annotations</a> adds local highlights and comments
    to any document or presentation. Try the <a href="/labs/annotations/"
      >text annotation lab</a
    >.
  </p>
  <p>
    Change parameters to regenerate the preview and source together. Presets
    provide useful combinations; Reset restores the example.
  </p>
  <p>
    The separate <a href="/docs/native-content/"
      >native HTML and media reference</a
    > covers browser elements styled by the theme. The <a
      href="/docs/playground/">Playground component</a
    > supplies the same preview, source, and controls across the docs.
  </p>
</DocsLayout>
