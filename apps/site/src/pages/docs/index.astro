---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docsGroups, docsReference } from '../../lib/docs-navigation';
---

<DocsLayout
  title="Documentation"
  description="Build, customize, and publish your Alkemist site."
>
  <div class="docs-directory">
    {
      docsGroups.map((group) => (
        <section>
          <h2>{group.label}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>
                  {link.label}
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <div class="docs-reference-links">
    <h2>Project reference</h2>
    <ul>
      {
        docsReference.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="docs-footnote">
    Alkemist is available from a source checkout. The packages are not yet
    published to npm.
  </p>
</DocsLayout>
