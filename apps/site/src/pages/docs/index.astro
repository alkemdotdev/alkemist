---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docsGroups, docsReference } from '../../lib/docs-navigation';
---

<DocsLayout
  title="Documentation"
  description="Build, customize, and publish your Alkemist site."
>
  <div class="docs-start">
    <div>
      <h2>Start with your own site.</h2>
      <p>
        Follow the setup guide, or give the same instructions to your coding
        agent.
      </p>
    </div>
    <div class="docs-start-links">
      <a class="docs-primary" href="/docs/getting-started/"
        >Create a site <span aria-hidden="true">→</span></a
      >
      <a href="/docs/agent-setup.md">Read the agent instructions</a>
    </div>
  </div>
  <div class="docs-directory">
    {
      docsGroups.map((group) => (
        <section>
          <h2>{group.label}</h2>
          <p>{group.description}</p>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>
                  {link.label}
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <div class="docs-reference-links">
    <h2>Project reference</h2>
    <p>Package boundaries, API conventions, and this demo's configuration.</p>
    <ul>
      {
        docsReference.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="docs-footnote">
    Alkemist is available from a source checkout. The packages are not yet
    published to npm.
  </p>
</DocsLayout>
