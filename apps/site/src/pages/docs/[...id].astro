---
import AlkLayout from '@alkemist/ui/AlkLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { isPreview } from '../../lib/deployment';
export async function getStaticPaths() {
  return (await getCollection('docs')).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'docs'> };
const { Content } = await render(entry);
const docs = (await getCollection('docs')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<AlkLayout
  title={entry.data.title}
  description={entry.data.description}
  preview={isPreview}
>
  <div class="alk-doc-shell">
    <aside class="alk-sidebar">
      <p class="alk-eyebrow">Documentation</p><nav aria-label="Documentation">
        {
          docs.map((doc) => (
            <a
              href={`/docs/${doc.id}/`}
              aria-current={doc.id === entry.id ? 'page' : undefined}
            >
              {doc.data.title}
            </a>
          ))
        }
      </nav>
    </aside>
    <article class="alk-prose">
      <h1>{entry.data.title}</h1><p class="alk-lead">
        {entry.data.description}
      </p><Content />
    </article>
  </div>
</AlkLayout>
