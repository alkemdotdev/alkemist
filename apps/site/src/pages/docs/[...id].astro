---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { isPreview } from '../../lib/deployment';
export async function getStaticPaths() {
  return (await getCollection('docs')).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'docs'> };
const { Content } = await render(entry);
const docs = (await getCollection('docs')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.description}
  preview={isPreview}
>
  <div class="alk-doc-shell">
    <aside class="alk-sidebar">
      <details class="docs-menu" open>
        <summary class="alk-eyebrow">Documentation</summary><nav
          aria-label="Documentation"
        >
          <a href="/docs/components/">Component catalog</a>
          {
            docs.map((doc) => (
              <a
                href={`/docs/${doc.id}/`}
                aria-current={doc.id === entry.id ? 'page' : undefined}
              >
                {doc.data.title}
              </a>
            ))
          }
        </nav>
      </details>
    </aside>
    <article class="alk-prose">
      <h1>{entry.data.title}</h1><p class="alk-lead">
        {entry.data.description}
      </p><Content />
    </article>
  </div>
</SiteLayout>

<style>
  .docs-menu {
    border: 0;
    padding: 0;
  }
  .docs-menu summary {
    cursor: pointer;
    margin: 0;
    padding: 0;
  }
  .docs-menu[open] summary {
    margin-bottom: 1.25rem;
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.docs-menu');
  const narrow = matchMedia('(max-width: 650px)');
  const adaptMenu = () => {
    if (menu) menu.open = !narrow.matches;
  };
  adaptMenu();
  narrow.addEventListener('change', adaptMenu);
</script>
