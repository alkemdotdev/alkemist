---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { isPreview } from '../../lib/deployment';
export async function getStaticPaths() {
  return (await getCollection('blog'))
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      params: { id: entry.id },
      props: { entry },
    }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'blog'> };
const { Content } = await render(entry);
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.description}
  preview={isPreview}
  ><article class="alk-prose">
    <p class="blog-meta">
      <a href="/blog/">← Blog</a><time datetime={entry.data.date}
        >{entry.data.date}</time
      >
    </p><h1>{entry.data.title}</h1><p class="alk-lead">
      {entry.data.description}
    </p>{
      entry.data.cover?.showInPost && (
        <figure
          class="blog-cover"
          style={`--cover-fit: ${entry.data.cover.fit}; --cover-position: ${entry.data.cover.focalX}% ${entry.data.cover.focalY}%;`}
        >
          <Image
            src={entry.data.cover.src}
            alt={entry.data.cover.alt}
            widths={[720, 1200, 1600]}
            sizes="(max-width: 800px) calc(100vw - 2.5rem), 800px"
            loading="eager"
            format="webp"
          />
          {entry.data.cover.caption && (
            <figcaption>{entry.data.cover.caption}</figcaption>
          )}
        </figure>
      )
    }<Content />
  </article></SiteLayout
>

<style>
  .blog-meta {
    display: flex;
    gap: 1.3rem;
    align-items: center;
    color: var(--alk-muted);
    font: 0.75rem var(--alk-mono);
    margin-bottom: 1.4rem;
  }
  .blog-meta a {
    color: inherit;
    text-decoration: none;
  }
  .blog-meta a:hover {
    text-decoration: underline;
  }
  .blog-cover {
    margin: 2rem 0;
  }
  .blog-cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: var(--cover-fit);
    object-position: var(--cover-position);
  }
  .blog-cover figcaption {
    color: var(--alk-muted);
    font-size: 0.82rem;
    margin-top: 0.55rem;
  }
</style>
