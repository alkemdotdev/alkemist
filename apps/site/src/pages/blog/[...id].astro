---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { isPreview } from '../../lib/deployment';
export async function getStaticPaths() {
  return (await getCollection('blog')).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'blog'> };
const { Content } = await render(entry);
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.description}
  preview={isPreview}
  ><article class="alk-prose">
    <p class="blog-meta">
      <a href="/blog/">← Blog</a><time datetime={entry.data.date}
        >{entry.data.date}</time
      >
    </p><h1>{entry.data.title}</h1><p class="alk-lead">
      {entry.data.description}
    </p><Content />
  </article></SiteLayout
>

<style>
  .blog-meta {
    display: flex;
    gap: 1.3rem;
    align-items: center;
    color: var(--alk-muted);
    font: 0.75rem var(--alk-mono);
    margin-bottom: 1.4rem;
  }
  .blog-meta a {
    color: inherit;
    text-decoration: none;
  }
  .blog-meta a:hover {
    text-decoration: underline;
  }
</style>
