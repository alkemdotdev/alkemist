---
import AlkPostList from '@alkemdotdev/alkemist-components/AlkPostList.astro';
import { blogDisplay } from '../../lib/sections';
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { isPreview } from '../../lib/deployment';
const notes = (await getCollection('blog'))
  .filter((entry) => !entry.data.draft)
  .sort(
    (a, b) =>
      (b.data.date ?? '').localeCompare(a.data.date ?? '') ||
      a.data.order - b.data.order ||
      a.id.localeCompare(b.id),
  );
---

<SiteLayout
  title="Blog"
  description="Build notes, experiments, and releases from Alkemist."
  preview={isPreview}
>
  <h1>Blog</h1>
  <p class="alk-lead">Build notes, experiments, and releases.</p>
  <AlkPostList
    {...blogDisplay}
    items={notes.map((note) => ({
      href: `/blog/${note.id}/`,
      title: note.data.title,
      description: note.data.description,
      date: note.data.date,
      cover: note.data.cover,
    }))}
  />
</SiteLayout>
