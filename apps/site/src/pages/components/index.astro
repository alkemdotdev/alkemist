---
import AlkLayout from '@alkemist/ui/AlkLayout.astro';
import { isPreview } from '../../lib/deployment';
const items = [
  [
    'AlkLayout',
    'Available',
    'Ubuntu typography, #eee whiteboard and #111 blackboard, local fonts, responsive navigation, and print styles.',
  ],
  [
    'AlkMath / AlkCode',
    'Available',
    'KaTeX equations and MathML; Shiki code, captions, line highlights, numbers, and copy controls.',
  ],
  [
    'AlkChart',
    'Available',
    'CSV line, bar, scatter, pie, donut, and heatmap; grids, tooltips, source tables, and line/scatter pan and zoom.',
  ],
  [
    'AlkModel',
    'Available',
    'Uncompressed GLB/glTF with orbit controls, camera presets, wireframe, and a static poster.',
  ],
  [
    'AlkShader',
    'Available · fixed study',
    'An interactive WebGL2 interference field with frequency and angle controls. A general shader authoring API is planned.',
  ],
  [
    'AlkPointCloud / AlkSplat / AlkRobot',
    'Planned',
    'Point clouds, Gaussian splats, and robot joint controls need qualified format adapters and real examples.',
  ],
];
---

<AlkLayout
  title="Components"
  section="Public API / Alk prefix"
  preview={isPreview}
  ><h1>A small vocabulary. A large workbench.</h1><p class="alk-lead">
    Every Alkemist component has an Alk prefix. Their documentation lives beside
    the site that uses them.
  </p><div class="alk-notice">
    Explore the working components on the <a href="/test/">specimen board</a>.
    Available means implemented in this repository; the packages are not yet
    published to npm.
  </div><div class="alk-grid">
    {
      items.map(([name, status, description]) => (
        <article>
          <>
            <p class="alk-pill">{status}</p>
            <h3>{name}</h3>
            <p>{description}</p>
          </>
        </article>
      ))
    }
  </div><div class="alk-links">
    <a href="/docs/charts/">Chart types and options →</a><a href="/docs/naming/"
      >Naming conventions →</a
    >
  </div></AlkLayout
>
