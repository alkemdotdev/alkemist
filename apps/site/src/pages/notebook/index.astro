---
import AlkLayout from '@alkemist/ui/AlkLayout.astro';
import { getCollection } from 'astro:content';
import { isPreview } from '../../lib/deployment';
const notes = await getCollection('notebook');
---

<AlkLayout title="Notebook" section="Building Alkemist" preview={isPreview}
  ><h1>The notebook behind the notebook.</h1><p class="alk-lead">
    Decisions, experiments, and working evidence from the development of
    Alkemist.
  </p><ul class="alk-index">
    {
      notes.map((note) => (
        <li>
          <>
            <span class="alk-pill">{note.data.date}</span>
            <br />
            <a href={`/notebook/${note.id}/`}>{note.data.title}</a>
            <p>{note.data.description}</p>
          </>
        </li>
      ))
    }
  </ul></AlkLayout
>
