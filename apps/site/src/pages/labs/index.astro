---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { isPreview } from '../../lib/deployment';
const tools = [
  {
    name: 'Interference field',
    href: '/labs/interference/',
    description: 'Adjust two wave sources and inspect the resulting field.',
  },
  {
    name: 'Theme studio',
    href: '/labs/design-studio/',
    description:
      'Try fonts, inks, and board details. Copy or download your choices.',
  },
];
const studies = [
  {
    name: 'Field studies',
    href: '/labs/field-studies/',
    description: 'Flux core and three other layered sculptures.',
  },
  {
    name: 'Mathematical sculptures',
    href: '/labs/sculpture-studies/',
    description: 'Enneper, Gyroid, Dipole, and a planetary gear stage.',
  },
  {
    name: 'Hero studies',
    href: '/labs/hero-studies/',
    description: 'Sculpture, shader, and illustration compositions.',
  },
  {
    name: 'Homepage studies',
    href: '/labs/homepage-studies/',
    description: 'Three earlier approaches to the homepage.',
  },
  {
    name: 'Board studies',
    href: '/labs/board-studies/',
    description: 'Whiteboard and blackboard treatments.',
  },
];
---

<SiteLayout
  title="Labs"
  description="Small tools and interactive experiments built with Alkemist."
  preview={isPreview}
>
  <header class="labs-heading">
    <h1>Labs</h1><p class="alk-lead">
      Small tools and interactive experiments.
    </p>
  </header>
  <div class="labs-tools">
    {
      tools.map((tool) => (
        <a class="labs-tool" href={tool.href}>
          <>
            <h2>
              {tool.name} <span aria-hidden="true">↗</span>
            </h2>
            <p>{tool.description}</p>
          </>
        </a>
      ))
    }
  </div>
  <p class="labs-components">
    Looking for charts, models, or code examples? <a href="/test/"
      >Open the test page →</a
    >
  </p>
  <details class="labs-history">
    <summary>Design studies</summary>
    <ul>
      {
        studies.map((study) => (
          <li>
            <>
              <a href={study.href}>
                {study.name} <span aria-hidden="true">↗</span>
              </a>
              <p>{study.description}</p>
            </>
          </li>
        ))
      }
    </ul>
  </details>
</SiteLayout>

<style>
  .labs-heading {
    margin-bottom: 2rem;
  }
  .labs-heading h1 {
    margin-bottom: 0.65rem;
  }
  .labs-heading p {
    margin: 0;
  }
  .labs-tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .labs-tool {
    display: block;
    padding: 1.4rem;
    border: 1px solid var(--alk-rule);
    border-radius: 4px;
    text-decoration: none;
  }
  .labs-tool:hover {
    border-color: var(--alk-muted);
  }
  .labs-tool h2 {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 1.3rem;
    margin: 0 0 0.7rem;
  }
  .labs-tool h2 span {
    font: 1rem var(--alk-mono);
  }
  .labs-tool p {
    color: var(--alk-muted);
    font-size: 0.95rem;
    margin: 0;
    max-width: 44ch;
  }
  .labs-components {
    color: var(--alk-muted);
    font-size: 0.85rem;
    margin: 1.3rem 0 0;
  }
  .labs-history {
    border-top: 1px solid var(--alk-rule);
    margin-top: 3rem;
    padding-top: 1.7rem;
  }
  .labs-history p {
    color: var(--alk-muted);
    font-size: 0.9rem;
    margin: 0;
  }
  details {
    padding: 0;
    border: 0;
  }
  summary {
    cursor: pointer;
    padding: 0.2rem 0;
    font-size: 0.95rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 1.3rem 0 0;
  }
  li {
    border-top: 1px solid var(--alk-rule);
    padding: 0.8rem 0;
    margin: 0;
  }
  li a {
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
  }
  li a:hover {
    text-decoration: underline;
  }
  li p {
    margin-top: 0.3rem;
  }
  @media (max-width: 650px) {
    .labs-tools {
      grid-template-columns: 1fr;
    }
    .labs-history {
      margin-top: 2rem;
    }
    .labs-tool {
      padding: 1.15rem;
    }
  }
</style>
