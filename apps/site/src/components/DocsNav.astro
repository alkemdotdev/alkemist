---
import Navigation from '@alkemdotdev/alkemist-components/navigation';
import { docsNavigation, docsReference } from '../lib/docs-navigation';
interface Props {
  headings?: { depth: number; slug: string; text: string }[];
}
const { headings = [] } = Astro.props;
const currentPath = Astro.url.pathname;
const inReference = docsReference.some((item) => item.href === currentPath);
---

<aside class="docs-sidebar" data-pagefind-ignore>
  <details class="docs-menu" open>
    <summary>Documentation <span>Browse pages</span></summary>
    <div class="docs-nav-title">Documentation</div>
    <Navigation
      items={docsNavigation}
      currentPath={currentPath}
      headings={headings}
    />
    <details class="docs-reference" open={inReference}>
      <summary>Project reference</summary>
      <Navigation
        items={docsReference}
        currentPath={currentPath}
        label="Project reference"
        headings={headings}
      />
    </details>
  </details>
</aside>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.docs-menu');
  const narrow = matchMedia('(max-width: 760px)');
  const adaptMenu = () => {
    if (menu) menu.open = !narrow.matches;
  };
  adaptMenu();
  narrow.addEventListener('change', adaptMenu);
</script>
