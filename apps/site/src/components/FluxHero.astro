---
import FormArt from './forms/FormArt.astro';
import poster from '../assets/fields/flux.png';
---

<section class="flux-hero" aria-labelledby="home-title">
  <div class="flux-copy">
    <h1 id="home-title">Make ideas<br />explorable.</h1>
  </div>
  <div class="flux-art">
    <FormArt take="flux" poster={poster} presentation="hero" />
  </div>
  <div class="flux-summary">
    <p class="flux-intro">
      An Astro starting point for inventors and researchers, with math, code,
      charts, and interactive models.
    </p>
    <div class="flux-actions">
      <a class="start-primary" href="#start"
        >Start using Alkemist <span aria-hidden="true">↗</span></a
      >
      <a href="/test/">See examples <span aria-hidden="true">→</span></a>
    </div>
    <p class="flux-source">
      <a href="/docs/status/">Public source</a> · Astro publishing toolkit
    </p>
  </div>
</section>

<style>
  .flux-hero {
    display: grid;
    grid-template-columns: 0.92fr 1.25fr;
    grid-template-areas: 'heading art' 'summary art';
    grid-template-rows: 1fr 1fr;
    align-items: center;
    gap: 0 1rem;
    padding: 0.7rem 0 2.8rem;
  }
  .flux-copy {
    min-width: 0;
    grid-area: heading;
    align-self: end;
  }
  .flux-summary {
    grid-area: summary;
    align-self: start;
  }
  h1 {
    font: 400 clamp(3.5rem, 5.5vw, 4.9rem)/1.04 var(--alk-sans);
    letter-spacing: -0.055em;
    margin: 0 0 1.6rem;
  }
  .flux-intro {
    max-width: 39ch;
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--alk-muted);
    margin: 0;
  }
  .flux-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.6rem;
    margin-top: 2rem;
    font-size: 0.85rem;
  }
  .flux-actions a {
    text-decoration: none;
  }
  .flux-actions a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .flux-actions .start-primary {
    font-size: 0.87rem;
    border-radius: 3px;
  }
  .flux-source {
    margin: 1.2rem 0 0;
    color: var(--alk-muted);
    font: 0.68rem/1.5 var(--alk-mono);
  }
  .flux-source a {
    text-decoration: none;
  }
  .flux-source a:hover {
    text-decoration: underline;
  }
  .flux-art {
    grid-area: art;
    margin: 0;
    min-width: 0;
  }
  .flux-art :global(.form-viewport) {
    aspect-ratio: 1.25;
  }
  @media (max-width: 1000px) {
    .flux-hero {
      grid-template-columns: 0.95fr 1.1fr;
    }
    h1 {
      font-size: clamp(3rem, 6vw, 4rem);
    }
    .flux-intro {
      font-size: 1rem;
    }
    .flux-actions {
      gap: 1rem;
    }
  }
  @media (max-width: 700px) {
    .flux-hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      padding: 0 0 2rem;
    }
    .flux-copy {
      padding-top: 0.5rem;
      align-self: stretch;
    }
    .flux-summary {
      align-self: stretch;
      margin-top: 1.8rem;
    }
    h1 {
      font-size: clamp(3.2rem, 10.8vw, 4.8rem);
      margin-bottom: 1.2rem;
    }
    .flux-intro {
      max-width: 42ch;
      font-size: 1rem;
    }
    .flux-actions {
      margin-top: 1.5rem;
      gap: 1.2rem;
      font-size: 0.8rem;
    }
    .flux-actions .start-primary {
      padding: 0.85rem 1rem;
      font-size: 0.8rem;
    }
    .flux-source {
      font-size: 0.62rem;
      margin-top: 1rem;
    }
    .flux-art {
      margin-top: 0;
    }
    .flux-art :global(.form-viewport) {
      aspect-ratio: 1.4;
    }
  }
</style>
