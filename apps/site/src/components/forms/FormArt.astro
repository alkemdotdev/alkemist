---
import FormPoster from './FormPoster.astro';
import AlkMath from '@alkemist/ui/AlkMath.astro';
import { formStudies } from './catalog';
import type { FormId } from './types';
interface Props {
  take: FormId;
}
const { take } = Astro.props;
const study = formStudies.find((item) => item.id === take)!;
const scene = study.make();
---

<form-art data-form={take} data-state="idle">
  <div class="form-viewport" aria-busy="false">
    <FormPoster scene={scene} label={`${study.name}: ${study.description}`} />
    <canvas
      tabindex="-1"
      inert
      aria-hidden="true"
      role="img"
      aria-label={`${study.name}. ${study.description} Drag horizontally or use arrow keys to turn. Home resets the view.`}
    ></canvas>
    <div class="form-apparatus" aria-hidden="true">
      <span>{study.domain}</span><span>Interactive specimen / 3D</span>
    </div>
    <div class="form-annotations" data-form-note aria-hidden="true">
      <svg
        >{
          scene.annotations?.map(() => (
            <>
              <>
                <path data-annotation-leader />
                <circle data-annotation-anchor r="2" />
              </>
            </>
          ))
        }</svg
      >
      {
        scene.annotations?.map((annotation) => (
          <span class="form-label" data-annotation-label>
            <>
              <strong>{annotation.label}</strong>
              <span>{annotation.detail}</span>
            </>
          </span>
        ))
      }
    </div>
  </div>
  <div class="form-equation">
    <AlkMath tex={study.equation} display={false} /><span>{study.note}</span>
  </div>
  <div class="form-controls">
    <div class="form-inspect">
      <span>Drag to turn <span aria-hidden="true">↔</span></span><button
        type="button"
        data-form-zoom="out"
        aria-label="Zoom out"
        disabled>−</button
      ><button type="button" data-form-zoom="in" aria-label="Zoom in" disabled
        >+</button
      >
    </div>
    <div>
      <button type="button" data-form-play aria-pressed="false" disabled
        >Play motion</button
      ><button type="button" data-form-reset disabled>Reset view</button>
    </div>
  </div>
  <p class="form-status" role="status">
    The still composition is shown while the interactive view loads.
  </p>
</form-art>
<script>
  import './runtime';
</script>
