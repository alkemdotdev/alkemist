---
import { getImage } from 'astro:assets';
import { preparePostListItems, type PostListProps } from './post-list-helpers';
import { escapeHtml, renderPostList } from './website-renderers';

export type {
  PostListCover,
  PostListItem,
  PostListLayout,
  PostListProps,
} from './post-list-helpers';

type Props = PostListProps;

const {
  items,
  layout = 'rows',
  selectable = false,
  featuredHref,
  label = 'Posts',
} = Astro.props;
const orderedItems = preparePostListItems(items, featuredHref);
const resolvedImages = await Promise.all(
  orderedItems.map(async (item, index) => {
    const cover = item.cover;
    if (!cover || typeof cover.src === 'string') return undefined;
    const image = await getImage({
      src: cover.src,
      widths: [480, 800, 1200],
      sizes: '(max-width: 42rem) 100vw, 50vw',
    });
    const attributes = image.attributes;
    return `<img src="${escapeHtml(image.src)}"${image.srcSet.attribute ? ` srcset="${escapeHtml(image.srcSet.attribute)}"` : ''}${attributes.sizes ? ` sizes="${escapeHtml(attributes.sizes)}"` : ''} alt="${escapeHtml(cover.alt)}" width="${attributes.width}" height="${attributes.height}" loading="${index === 0 ? 'eager' : 'lazy'}" fetchpriority="${index === 0 ? 'high' : 'auto'}">`;
  }),
);
---

<Fragment
  set:html={renderPostList(
    { items, layout, selectable, featuredHref, label },
    resolvedImages,
  )}
/>

<script>
  import './post-list-client';
</script>

<style is:global>
  alk-post-list {
    --alk-post-rule: var(--alk-rule, #ccc);
    --alk-post-paper: var(--alk-paper, #fff);
    --alk-post-field: var(--alk-field, #f2f2f2);
    --alk-post-ink: var(--alk-ink, #111);
    --alk-post-muted: var(--alk-muted, #5e5e5e);
    --alk-post-sans: var(--alk-sans, system-ui, sans-serif);
    --alk-post-mono: var(--alk-mono, ui-monospace, monospace);
    display: block;
    color: var(--alk-post-ink);
    container-type: inline-size;
  }

  .alk-post-list-layout-control {
    display: none;
    align-items: center;
    justify-content: flex-end;
    gap: 0.55rem;
    margin-bottom: 0.5rem;
    color: var(--alk-post-muted);
    font: 0.72rem/1.4 var(--alk-post-mono);
  }

  alk-post-list[data-enhanced='true'] .alk-post-list-layout-control {
    display: flex;
  }

  .alk-post-list-layout-control select {
    border: 1px solid var(--alk-post-rule);
    border-radius: 0;
    background: var(--alk-post-paper);
    color: var(--alk-post-ink);
    font: inherit;
    padding: 0.32rem 0.45rem;
  }

  .alk-post-list-items {
    display: grid;
    gap: 0;
  }

  .alk-post-list-item {
    min-width: 0;
    border-top: 1px solid var(--alk-post-rule);
  }

  .alk-post-list-item:last-child {
    border-bottom: 1px solid var(--alk-post-rule);
  }

  .alk-post-list-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6.5rem;
    gap: 0.65rem;
    color: inherit;
    padding: 0.75rem 0;
    text-decoration: none;
  }

  .alk-post-list-link:focus-visible {
    outline: 2px solid var(--alk-ink-cobalt, #1982f2);
    outline-offset: 4px;
  }

  .alk-post-thumbnail {
    width: 100%;
    grid-column: 2;
    grid-row: 1;
    aspect-ratio: 3 / 2;
    background: var(--alk-post-field);
    overflow: hidden;
  }

  .alk-post-thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-position: var(--alk-post-focal-x) var(--alk-post-focal-y);
  }

  .alk-post-thumbnail[data-fit='cover'] img {
    object-fit: cover;
  }

  .alk-post-thumbnail[data-fit='contain'] img {
    object-fit: contain;
  }

  .alk-post-list-copy {
    align-self: center;
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .alk-post-list-copy h2 {
    margin: 0;
    font: 500 clamp(1.05rem, 2cqi, 1.3rem) / 1.35 var(--alk-post-sans);
  }

  .alk-post-list-copy p {
    margin: 0.3rem 0 0;
    color: var(--alk-post-muted);
    font: 0.88rem/1.5 var(--alk-post-sans);
  }

  .alk-post-list-copy time {
    display: block;
    margin-top: 0.4rem;
    color: var(--alk-post-muted);
    font: 0.7rem/1.4 var(--alk-post-mono);
  }

  .alk-post-list-item:not([data-has-cover]) .alk-post-list-link {
    grid-template-columns: minmax(0, 1fr);
  }

  alk-post-list[data-layout='grid'] .alk-post-list-link,
  alk-post-list[data-layout='featured-grid'] .alk-post-list-link,
  alk-post-list[data-layout='featured']
    .alk-post-list-item[data-lead]
    .alk-post-list-link {
    display: block;
  }

  alk-post-list[data-layout='grid'] .alk-post-thumbnail,
  alk-post-list[data-layout='featured-grid'] .alk-post-thumbnail,
  alk-post-list[data-layout='featured']
    .alk-post-list-item[data-lead]
    .alk-post-thumbnail {
    margin-bottom: 0.65rem;
  }

  alk-post-list[data-layout='featured']
    .alk-post-list-item[data-lead]
    .alk-post-thumbnail,
  alk-post-list[data-layout='featured-grid']
    .alk-post-list-item[data-lead]
    .alk-post-thumbnail {
    max-height: 22rem;
  }

  @container (min-width: 42rem) {
    .alk-post-list-link {
      grid-template-columns: minmax(0, 1fr) 11rem;
      gap: clamp(1rem, 3cqi, 2rem);
      padding: clamp(0.75rem, 2cqi, 1.2rem) 0;
    }

    alk-post-list[data-layout='grid'] .alk-post-list-items,
    alk-post-list[data-layout='featured-grid'] .alk-post-list-items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1rem, 3cqi, 2rem);
    }

    alk-post-list[data-layout='grid'] .alk-post-list-link,
    alk-post-list[data-layout='featured-grid']
      .alk-post-list-item:not([data-lead])
      .alk-post-list-link {
      display: block;
    }

    alk-post-list[data-layout='grid'] .alk-post-thumbnail,
    alk-post-list[data-layout='featured-grid']
      .alk-post-list-item:not([data-lead])
      .alk-post-thumbnail {
      margin-bottom: 0.65rem;
    }

    alk-post-list[data-layout='grid'] .alk-post-list-item:nth-last-child(2),
    alk-post-list[data-layout='grid'] .alk-post-list-item:last-child,
    alk-post-list[data-layout='featured-grid']
      .alk-post-list-item:nth-last-child(2),
    alk-post-list[data-layout='featured-grid'] .alk-post-list-item:last-child {
      border-bottom: 1px solid var(--alk-post-rule);
    }

    alk-post-list[data-layout='featured']
      .alk-post-list-item[data-lead]
      .alk-post-list-link,
    alk-post-list[data-layout='featured-grid'] .alk-post-list-item[data-lead] {
      grid-column: 1 / -1;
    }

    alk-post-list[data-layout='featured']
      .alk-post-list-item[data-lead]
      .alk-post-list-link,
    alk-post-list[data-layout='featured-grid']
      .alk-post-list-item[data-lead]
      .alk-post-list-link {
      display: block;
    }

    alk-post-list[data-layout='featured']
      .alk-post-list-item[data-lead]
      .alk-post-thumbnail,
    alk-post-list[data-layout='featured-grid']
      .alk-post-list-item[data-lead]
      .alk-post-thumbnail {
      aspect-ratio: 16 / 7;
      margin-bottom: clamp(0.65rem, 2cqi, 1rem);
    }

    alk-post-list[data-layout='featured']
      .alk-post-list-item[data-lead]
      .alk-post-list-copy
      h2,
    alk-post-list[data-layout='featured-grid']
      .alk-post-list-item[data-lead]
      .alk-post-list-copy
      h2 {
      font-size: clamp(1.35rem, 3cqi, 2rem);
    }
  }
</style>
