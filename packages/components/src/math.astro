---
import { renderMath } from './content-renderers';
import '@alkemdotdev/alkemist-theme/math-code.css';

export interface MathProps {
  tex: string;
  display?: boolean;
  label?: string;
}
type Props = MathProps;
const { tex, display = true, label } = Astro.props;
const html = renderMath({ tex, display, label });
---

<Fragment set:html={html} />
