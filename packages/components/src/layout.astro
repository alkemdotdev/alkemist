---
import '@alkemdotdev/alkemist-theme/theme.css';
import './header.css';
import HeaderIcon from './HeaderIcon.astro';
import Search, { type SearchProps } from './search.astro';
const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;
export interface NavLink {
  label: string;
  href: string;
}
export interface LayoutProps {
  title: string;
  description?: string;
  section?: string;
  preview?: boolean;
  siteName?: string;
  tagline?: string;
  faviconHref?: string;
  navigation?: NavLink[];
  moreNavigation?: NavLink[];
  footerNavigation?: NavLink[];
  /** Enables Pagefind-backed site search in the shared header. */
  search?: boolean | SearchProps;
}
type Props = LayoutProps;
const {
  title,
  description = 'An open workbench for publishing technical ideas. Built on Astro.',
  section = '',
  preview = false,
  siteName = 'Alkemist',
  tagline = 'an open workbench',
  faviconHref = `${home}favicon.svg`,
  navigation = [
    { label: 'Blog', href: `${home}blog/` },
    { label: 'Labs', href: `${home}labs/` },
    { label: 'Info', href: `${home}info/` },
  ],
  moreNavigation = [],
  footerNavigation = [],
  search = false,
}: Props = Astro.props;
const searchProps = search === true ? {} : search || undefined;
const canonical = new URL(Astro.url.pathname, Astro.site);
function current(href: string) {
  if (Astro.url.pathname === href) return 'page';
  if (
    href !== '/' &&
    href !== home &&
    Astro.url.pathname.startsWith(href.endsWith('/') ? href : `${href}/`)
  )
    return 'location';
  return undefined;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('alk-theme');
        const theme = ['light', 'dark', 'system'].includes(saved)
          ? saved
          : 'system';
        document.documentElement.dataset.alkTheme = theme;
        document.documentElement.style.colorScheme =
          theme === 'system' ? 'light dark' : theme;
      } catch {
        /* The system palette works without browser storage. */
      }
    </script>
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    <title>{title === siteName ? title : `${title} · ${siteName}`}</title>
  </head>
  <body>
    <a class="alk-skip" href="#main">Skip to content</a>
    {
      preview && (
        <div class="alk-preview">Branch preview · development build</div>
      )
    }
    <header class="alk-header" data-pagefind-ignore>
      <a class="alk-brand" href={home} aria-label={`${siteName} home`}
        >{siteName === 'Alkemist' ? 'alkemist' : siteName}{
          tagline && <span class="alk-brand-detail"> / {tagline}</span>
        }</a
      >
      <nav class="alk-desktop-nav" aria-label="Main navigation">
        {
          navigation.map(({ label, href }) => (
            <a href={href} aria-current={current(href)}>
              {label}
            </a>
          ))
        }
        {
          moreNavigation.length > 0 && (
            <details
              class="alk-more"
              data-header-panel
              name="alk-header-panels"
            >
              <summary
                data-current={
                  moreNavigation.some(({ href }) => current(href)) || undefined
                }
              >
                More <HeaderIcon name="chevron" />
              </summary>
              <div class="alk-more-links alk-header-panel">
                {moreNavigation.map(({ label, href }) => (
                  <a href={href} aria-current={current(href)}>
                    {label}
                  </a>
                ))}
              </div>
            </details>
          )
        }
      </nav>
      <div class="alk-header-actions">
        {searchProps && <Search variant="header" {...searchProps} />}
        <details
          class="alk-theme-menu"
          data-header-panel
          name="alk-header-panels"
          hidden
        >
          <summary class="alk-icon-button" title="Color theme: System">
            {
              (['light', 'dark', 'system'] as const).map((theme) => (
                <span data-theme-icon={theme}>
                  <HeaderIcon name={theme} />
                </span>
              ))
            }
            <span class="alk-sr-only" data-theme-label>Color theme: System</span
            >
          </summary>
          <div class="alk-theme-panel alk-header-panel">
            <fieldset>
              <legend>Appearance</legend>
              {
                (
                  [
                    ['light', 'Whiteboard'],
                    ['dark', 'Blackboard'],
                    ['system', 'System'],
                  ] as const
                ).map(([value, label]) => (
                  <label class="alk-theme-choice">
                    <input
                      type="radio"
                      name="alk-theme"
                      value={value}
                      checked={value === 'system'}
                    />
                    <HeaderIcon name={value} />
                    <span>{label}</span>
                    <span class="alk-choice-check">
                      <HeaderIcon name="check" />
                    </span>
                  </label>
                ))
              }
            </fieldset>
          </div>
        </details>
        {
          (navigation.length > 0 || moreNavigation.length > 0) && (
            <details
              class="alk-mobile-menu"
              data-header-panel
              name="alk-header-panels"
            >
              <summary
                class="alk-icon-button"
                aria-label="Navigation menu"
                title="Navigation menu"
              >
                <HeaderIcon name="menu" />
              </summary>
              <nav
                class="alk-mobile-links alk-header-panel"
                aria-label="Main navigation"
              >
                {navigation.map(({ label, href }) => (
                  <a href={href} aria-current={current(href)}>
                    <span>{label}</span>
                    <HeaderIcon name="chevron" />
                  </a>
                ))}
                {moreNavigation.length > 0 && (
                  <div class="alk-mobile-secondary">
                    {moreNavigation.map(({ label, href }) => (
                      <a href={href} aria-current={current(href)}>
                        <span>{label}</span>
                        <HeaderIcon name="chevron" />
                      </a>
                    ))}
                  </div>
                )}
              </nav>
            </details>
          )
        }
      </div>
    </header>
    <main id="main" class="alk-main" data-pagefind-body>
      {section && <p class="alk-eyebrow">{section}</p>}
      <slot />
    </main>
    <footer class="alk-footer" data-pagefind-ignore>
      <a href={home}>{siteName}</a><span
        >Made with the Alkemist theme on Astro.</span
      >
      {footerNavigation.map(({ label, href }) => <a href={href}>{label}</a>)}
    </footer>
    <script>
      import './code-copy';
      import './header';
    </script>
  </body>
</html>
