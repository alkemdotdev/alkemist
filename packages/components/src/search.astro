---
const base = import.meta.env.BASE_URL;
import { renderSearch } from './website-renderers';

export interface SearchProps {
  /** URL of Pagefind's generated runtime module. */
  indexUrl?: string;
  /** Placeholder shown in the search field. */
  placeholder?: string;
  /** Accessible label for the search field. */
  label?: string;
  /** Use the compact header presentation supplied by Layout. */
  variant?: 'header' | 'standalone';
}

type Props = SearchProps;
const {
  indexUrl = `${base}pagefind/pagefind.js`,
  placeholder = 'Search',
  label = 'Search this site',
  variant = 'standalone',
} = Astro.props;
---

<Fragment
  set:html={renderSearch({ indexUrl, placeholder, label, variant }).replace(
    '<alk-search ',
    `<alk-search${import.meta.env.DEV ? ' data-development="true"' : ''} `,
  )}
/>

<script>
  import './search-client';
</script>

<style is:global>
  alk-search {
    --alk-search-paper: var(--alk-paper, #fff);
    --alk-search-ink: var(--alk-ink, #222);
    --alk-search-muted: var(--alk-muted, #666);
    --alk-search-rule: var(--alk-rule, #ddd);
    --alk-search-field: var(--alk-field, #f5f5f5);
    --alk-search-sans: var(--alk-sans, system-ui, sans-serif);
    --alk-search-mono: var(--alk-mono, ui-monospace, monospace);
    --alk-search-highlight: var(--alk-ink-violet, #7650bd);
    position: relative;
    display: block;
    min-width: 0;
  }
  alk-search,
  alk-search *,
  alk-search *::before,
  alk-search *::after {
    box-sizing: border-box;
  }
  alk-search[data-variant='standalone'] .alk-search-desktop label {
    flex: 1;
  }
  alk-search[data-variant='standalone'] .alk-search-desktop input {
    width: 100%;
  }
  alk-search[data-variant='standalone'] > .alk-search-results {
    position: relative;
    top: auto;
    right: auto;
    width: 100%;
    margin-top: 0.4rem;
    box-shadow: none;
  }
  alk-search .alk-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  alk-search .alk-icon-button {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 7px;
    color: var(--alk-search-muted);
  }
  alk-search .alk-icon-button:hover {
    background: var(--alk-search-field);
    color: var(--alk-search-ink);
  }
  alk-search .alk-search-desktop {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--alk-search-rule);
    background: var(--alk-search-field);
    padding: 0 0.45rem;
  }
  alk-search .alk-search-desktop label {
    min-width: 0;
  }
  alk-search .alk-search-desktop input {
    width: 12rem;
    min-width: 0;
    border: 0;
    outline: 0;
    padding: 0.43rem 0;
    color: var(--alk-search-ink);
    background: transparent;
    font: 0.78rem var(--alk-search-mono);
  }
  alk-search .alk-search-desktop kbd {
    border: 1px solid var(--alk-search-rule);
    color: var(--alk-search-muted);
    font: 0.62rem var(--alk-search-mono);
    line-height: 1;
    padding: 0.2rem;
  }
  alk-search .alk-search-mobile {
    display: none;
    border: 0;
    background: transparent;
  }
  alk-search .alk-search-mobile svg {
    width: 20px;
    height: 20px;
  }
  alk-search .alk-search-results {
    position: absolute;
    z-index: 40;
    top: calc(100% + 0.5rem);
    right: 0;
    width: min(31rem, calc(100vw - 2.5rem));
    max-height: min(60vh, 34rem);
    overflow: auto;
    padding: 0.35rem;
    border: 1px solid var(--alk-search-rule);
    background: var(--alk-search-paper);
    box-shadow: 0 0.7rem 1.5rem #0002;
    color: var(--alk-search-muted);
    font: 0.78rem/1.45 var(--alk-search-mono);
  }
  alk-search:has(.alk-search-dialog[open]) > .alk-search-results {
    display: none;
  }
  alk-search .alk-search-result-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  alk-search .alk-search-result {
    display: grid;
    gap: 0.3rem;
    padding: 0.55rem;
    color: var(--alk-search-ink);
    text-decoration: none;
  }
  alk-search .alk-search-result:hover {
    background: var(--alk-search-field);
  }
  alk-search .alk-search-result strong {
    font: 500 0.92rem var(--alk-search-sans);
  }
  alk-search .alk-search-result span {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    color: var(--alk-search-muted);
  }
  alk-search .alk-search-more {
    width: 100%;
    margin-top: 0.45rem;
    border: 1px solid var(--alk-search-rule);
    padding: 0.5rem;
    background: var(--alk-search-field);
    color: var(--alk-search-ink);
    font: 0.72rem/1.35 var(--alk-search-mono);
    text-align: left;
  }
  alk-search .alk-search-result mark {
    color: inherit;
    background: color-mix(
      in srgb,
      var(--alk-search-highlight) 30%,
      transparent
    );
  }
  alk-search .alk-search-dialog {
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(42rem, calc(100vh - 2rem));
    padding: 0;
    border: 1px solid var(--alk-search-rule);
    background: var(--alk-search-paper);
    color: var(--alk-search-ink);
    box-shadow: 0 1rem 3rem #0005;
  }
  alk-search .alk-search-dialog::backdrop {
    background: #0008;
  }
  alk-search .alk-search-dialog-bar {
    display: flex;
    align-items: end;
    gap: 0.5rem;
    padding: 1rem;
    border-bottom: 1px solid var(--alk-search-rule);
  }
  alk-search .alk-search-dialog form {
    flex: 1;
    min-width: 0;
  }
  alk-search .alk-search-dialog label {
    display: grid;
    gap: 0.3rem;
    color: var(--alk-search-muted);
    font: 0.72rem var(--alk-search-mono);
  }
  alk-search .alk-search-dialog input {
    width: 100%;
    border: 1px solid var(--alk-search-rule);
    padding: 0.6rem;
    background: var(--alk-search-field);
    color: var(--alk-search-ink);
  }
  alk-search .alk-search-dialog .alk-icon-button {
    border: 0;
    background: transparent;
    font-size: 1.5rem;
  }
  alk-search .alk-search-dialog .alk-search-results {
    position: static;
    width: auto;
    max-height: none;
    border: 0;
    box-shadow: none;
  }
  @media (max-width: 650px) {
    alk-search[data-variant='header'] .alk-search-desktop {
      display: none;
    }
    alk-search[data-variant='header'] .alk-search-mobile {
      display: grid;
    }
    alk-search[data-variant='header'] > .alk-search-results {
      display: none;
    }
  }
</style>
