---
import './shader.css';
import './figure.css';
export interface ShaderProps {
  title?: string;
  /** Spatial frequency, clamped to the visible control's range of 3–18. */
  frequency?: number;
  /** Rotation of the two sources in degrees, clamped to 0–180. */
  angle?: number;
  class?: string;
}
type Props = ShaderProps;
import { renderShader } from './visualization-renderers';
---

<Fragment set:html={renderShader(Astro.props)} />

<script>
  import './shader-client';
</script>
