---
import type { BundledLanguage } from 'shiki';
import { renderCode } from './content-renderers';
import type { CodeAnnotation, CollapsedCodeRange } from './code-theme';
import { resolveCodeSource } from './code-source';
import '@alkemdotdev/alkemist-theme/math-code.css';

export interface CodeProps {
  code?: string;
  lang?: BundledLanguage | 'text' | 'plaintext';
  title?: string;
  highlightLines?: number[];
  lineNumbers?: boolean;
  focusLines?: number[];
  addedLines?: number[];
  removedLines?: number[];
  collapsedRanges?: CollapsedCodeRange[];
  annotations?: CodeAnnotation[];
  highlightText?: string[];
  wrap?: boolean;
}
type Props = CodeProps;
const {
  code,
  lang = 'text',
  title,
  highlightLines,
  lineNumbers = true,
  focusLines,
  addedLines,
  removedLines,
  collapsedRanges,
  annotations,
  highlightText,
  wrap,
} = Astro.props;
const slotHtml = Astro.slots.has('default')
  ? await Astro.slots.render('default')
  : undefined;
const source = resolveCodeSource({ code, slotHtml });
const html = await renderCode({
  code: source,
  lang,
  title,
  highlightLines,
  lineNumbers,
  focusLines,
  addedLines,
  removedLines,
  collapsedRanges,
  annotations,
  highlightText,
  wrap,
});
---

<Fragment set:html={html} />

<script>
  import './code-copy';
</script>
