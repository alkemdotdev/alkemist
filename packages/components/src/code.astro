---
import { codeToHtml } from 'shiki';
import type { BundledLanguage } from 'shiki';
import { codeTheme, createCodeTransformer } from './code-theme';
import '@alkemdotdev/alkemist-theme/math-code.css';

export interface CodeProps {
  code: string;
  lang?: BundledLanguage | 'text' | 'plaintext';
  title?: string;
  highlightLines?: number[];
  lineNumbers?: boolean;
}
type Props = CodeProps;
const {
  code,
  lang = 'text',
  title,
  highlightLines,
  lineNumbers = true,
} = Astro.props;
const html = await codeToHtml(code, {
  lang,
  theme: codeTheme,
  transformers: [createCodeTransformer({ title, highlightLines, lineNumbers })],
});
---

<Fragment set:html={html} />

<script>
  import './code-copy';
</script>
