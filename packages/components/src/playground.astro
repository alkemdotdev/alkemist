---
import './playground.css';
import Code from './code.astro';
import {
  playgroundSource,
  resetPlaygroundValues,
  type PlaygroundDefinition,
} from './playground/helpers';
export interface PlaygroundProps {
  definition: PlaygroundDefinition;
  previewUrl: string;
  /** Give interactive demos the full width; reveal source and parameters on demand. */
  focusPreview?: boolean;
  /** Fixed iframe height for page-shell or scrolling navigation examples. */
  previewHeight?: number;
  /** Optional accurate initial source for native or custom renderers. */ initialSource?: string;
}
type Props = PlaygroundProps;
const {
  definition,
  previewUrl,
  initialSource: suppliedSource,
  focusPreview = false,
  previewHeight,
} = Astro.props;
if (
  previewHeight !== undefined &&
  (!Number.isFinite(previewHeight) ||
    previewHeight < 80 ||
    previewHeight > 1600)
)
  throw new TypeError('previewHeight must be between 80 and 1600 pixels.');
const Panel = focusPreview ? 'details' : 'section';
const values = resetPlaygroundValues(definition);
const initialSource = suppliedSource ?? playgroundSource(definition, values);
const instanceId = `alk-playground-${crypto.randomUUID()}`;
const sourceLanguage = definition.importPath ? 'astro' : 'html';
const sourceFilename = `${definition.id}.${definition.importPath ? 'astro' : 'html'}`;
---

<section
  class:list={['alk-playground', { 'alk-playground--focus': focusPreview }]}
  data-alk-playground
  data-pagefind-ignore
  data-playground-instance={instanceId}
  data-definition={JSON.stringify(definition)}
  aria-label={`${definition.name} playground`}
>
  <header class="alk-playground__header"><h2>{definition.name}</h2></header>
  <p
    class="alk-playground__status"
    data-playground-status
    role="status"
    aria-live="polite"
  >
    Preview loads when it becomes visible.
  </p>
  <div class="alk-playground__grid">
    <section class="alk-playground__preview" aria-label="Preview">
      <iframe
        title={`${definition.name} preview`}
        data-auto-resize={previewHeight === undefined ? undefined : 'false'}
        style={previewHeight ? `height:${previewHeight}px` : undefined}
        src={previewUrl}
        loading="lazy"
        sandbox="allow-scripts allow-same-origin"></iframe>
    </section>
    <Panel class="alk-playground__parameters" aria-label="Parameters">
      {focusPreview && <summary>Component parameters</summary>}
      {
        !focusPreview && (
          <div class="alk-playground__parameters-head">
            <>
              <h3>Parameters</h3>
              <button type="button" data-playground-reset>
                Reset
              </button>
            </>
          </div>
        )
      }
      {
        (focusPreview || (definition.presets?.length ?? 0) > 0) && (
          <div class="alk-playground__presets" aria-label="Presets">
            {definition.presets?.map((preset, index) => (
              <button type="button" data-playground-preset={index}>
                {preset.label}
              </button>
            ))}
            {focusPreview && (
              <button type="button" data-playground-reset>
                Reset
              </button>
            )}
          </div>
        )
      }
      <div class="alk-playground__controls">
        {
          definition.controls.map((control) => {
            const value = values[control.name];
            const inputId = `${instanceId}-${control.name}`;
            const errorId = `${inputId}-error`;
            const helpId = `${inputId}-help`;
            const isMultiline = control.type === 'textarea';
            const describedBy = control.help ? `${helpId} ${errorId}` : errorId;
            return (
              <label
                class:list={[
                  'alk-playground__control',
                  { 'alk-playground__control--multiline': isMultiline },
                ]}
                for={inputId}
              >
                <span class="alk-playground__control-label">
                  {control.label ?? control.name}
                </span>
                {isMultiline || control.type === 'json' ? (
                  <textarea
                    id={inputId}
                    name={control.name}
                    rows={isMultiline ? 2 : 1}
                    data-control
                    data-control-type={control.type}
                    aria-describedby={describedBy}
                    set:text={
                      '\n' +
                      (typeof value === 'string'
                        ? value
                        : JSON.stringify(value))
                    }
                  />
                ) : control.type === 'select' ? (
                  <select
                    id={inputId}
                    name={control.name}
                    data-control
                    data-control-type={control.type}
                    aria-describedby={describedBy}
                  >
                    {control.options?.map((option) => (
                      <option value={option} selected={value === option}>
                        {option}
                      </option>
                    ))}
                  </select>
                ) : control.type === 'boolean' ? (
                  <input
                    id={inputId}
                    name={control.name}
                    type="checkbox"
                    checked={value === true}
                    data-control
                    data-control-type={control.type}
                    aria-describedby={describedBy}
                  />
                ) : (
                  <input
                    id={inputId}
                    name={control.name}
                    type={control.type === 'number' ? 'number' : 'text'}
                    value={
                      typeof value === 'string' || typeof value === 'number'
                        ? value
                        : ''
                    }
                    min={control.min}
                    max={control.max}
                    step={control.step}
                    data-control
                    data-control-type={control.type}
                    aria-describedby={describedBy}
                  />
                )}
                {control.help && (
                  <small id={helpId} class="alk-playground__control-help">
                    {control.help}
                  </small>
                )}
                <small
                  id={errorId}
                  data-control-error={control.name}
                  role="alert"
                  hidden
                />
              </label>
            );
          })
        }
      </div>
    </Panel>
    <Panel class="alk-playground__source" aria-label="Generated source">
      {focusPreview && <summary>Source code</summary>}
      <div data-playground-source-host>
        <Code
          code={initialSource}
          lang={sourceLanguage}
          title={sourceFilename}
          lineNumbers={false}
        />
      </div>
    </Panel>
  </div>
  <noscript
    ><p class="alk-playground__nojs">
      Live controls require JavaScript. The initial preview and source remain
      available.
    </p><style is:inline>
      .alk-playground__parameters {
        display: none;
      }
      .alk-playground__grid {
        grid-template-columns: 1fr;
        grid-template-areas: 'preview' 'source';
      }
    </style></noscript
  >
</section>

<script>
  import './playground/client';
</script>
