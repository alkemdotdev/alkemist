---
import './theme.css';
export interface AlkNavLink {
  label: string;
  href: string;
}
export interface AlkLayoutProps {
  title: string;
  description?: string;
  section?: string;
  preview?: boolean;
  navigation?: AlkNavLink[];
  moreNavigation?: AlkNavLink[];
  footerNavigation?: AlkNavLink[];
}
type Props = AlkLayoutProps;
const {
  title,
  description = 'An open workbench for publishing technical ideas. Built on Astro.',
  section = '',
  preview = false,
  navigation = [
    { label: 'Blog', href: '/blog/' },
    { label: 'Labs', href: '/labs/' },
    { label: 'Info', href: '/info/' },
  ],
  moreNavigation = [],
  footerNavigation = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
function current(href: string) {
  if (Astro.url.pathname === href) return 'page';
  if (
    href !== '/' &&
    Astro.url.pathname.startsWith(href.endsWith('/') ? href : `${href}/`)
  )
    return 'location';
  return undefined;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title === 'Alkemist' ? title : `${title} · Alkemist`}</title>
  </head>
  <body>
    <a class="alk-skip" href="#main">Skip to content</a>
    {
      preview && (
        <div class="alk-preview">Branch preview · development build</div>
      )
    }
    <header class="alk-header">
      <a class="alk-brand" href="/" aria-label="Alkemist home"
        >alkemist<span class="alk-brand-detail"> / an open workbench</span></a
      >
      <nav aria-label="Main navigation">
        {
          navigation.map(({ label, href }) => (
            <a href={href} aria-current={current(href)}>
              {label}
            </a>
          ))
        }
        {
          moreNavigation.length > 0 && (
            <details class="alk-more">
              <summary
                data-current={
                  moreNavigation.some(({ href }) => current(href)) || undefined
                }
              >
                More <span aria-hidden="true">›</span>
              </summary>
              <div class="alk-more-links">
                {moreNavigation.map(({ label, href }) => (
                  <a href={href} aria-current={current(href)}>
                    {label}
                  </a>
                ))}
              </div>
            </details>
          )
        }
      </nav>
      <label class="alk-theme-label"
        ><span class="alk-sr-only">Color theme</span><select
          id="alk-theme"
          aria-label="Color theme"
          ><option value="system">System</option><option value="light"
            >Whiteboard</option
          ><option value="dark">Blackboard</option></select
        ></label
      >
    </header>
    <main id="main" class="alk-main">
      {section && <p class="alk-eyebrow">{section}</p>}
      <slot />
    </main>
    <footer class="alk-footer">
      <a href="/">Alkemist</a><span>Made with the Alkemist theme on Astro.</span
      >
      {footerNavigation.map(({ label, href }) => <a href={href}>{label}</a>)}
    </footer>
    <script>
      import './code-copy';
      const more = document.querySelector<HTMLDetailsElement>('.alk-more');
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && more?.open) {
          more.open = false;
          more.querySelector('summary')?.focus();
        }
      });
      document.addEventListener('click', (event) => {
        if (
          event.target instanceof Node &&
          more?.open &&
          !more.contains(event.target)
        )
          more.open = false;
      });
      const select = document.querySelector<HTMLSelectElement>('#alk-theme');
      function applyTheme(value: string) {
        document.documentElement.style.colorScheme =
          value === 'system' ? 'light dark' : value;
        if (select) select.value = value;
        window.dispatchEvent(new CustomEvent('alk:theme-change'));
      }
      try {
        const saved = localStorage.getItem('alk-theme');
        if (saved && ['light', 'dark', 'system'].includes(saved))
          applyTheme(saved);
      } catch {
        /* Storage can be disabled; the system theme remains usable. */
      }
      matchMedia('(prefers-color-scheme: dark)').addEventListener(
        'change',
        () => {
          if (select?.value === 'system') applyTheme('system');
        },
      );
      select?.addEventListener('change', () => {
        applyTheme(select.value);
        try {
          localStorage.setItem('alk-theme', select.value);
        } catch {
          /* Preference is session-only without storage. */
        }
      });
    </script>
  </body>
</html>
