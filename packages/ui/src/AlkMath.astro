---
import katex from 'katex';
import './math-code.css';

export interface AlkMathProps {
  tex: string;
  display?: boolean;
  label?: string;
}
type Props = AlkMathProps;
const { tex, display = true, label } = Astro.props;
const html = katex.renderToString(tex, {
  displayMode: display,
  output: 'htmlAndMathml',
  trust: false,
  throwOnError: true,
  strict: 'error',
  maxExpand: 1000,
  maxSize: 20,
});
---

{
  display ? (
    <figure class="alk-math">
      <div
        class="alk-math-scroll"
        tabindex="0"
        role="group"
        aria-label={label ?? 'Mathematical equation'}
        set:html={html}
      />
      {label && <figcaption>{label}</figcaption>}
    </figure>
  ) : (
    <span class="alk-math-inline" set:html={html} />
  )
}
