{
  "name": "alkemist-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @alkemist/site --",
    "build": "npm run build --workspace @alkemist/site",
    "check": "npm run check --workspace @alkemist/site",
    "test": "node --test scripts/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm test && npm run build && node scripts/check-build.mjs",
    "cloudflare:status": "node scripts/cloudflare.mjs status",
    "cloudflare:setup": "node scripts/cloudflare.mjs setup",
    "create:site": "node scripts/create-site.mjs",
    "check:starter": "node scripts/check-starter.mjs",
    "generate:palette": "node scripts/generate-palette.mjs",
    "generate:fixtures": "node scripts/generate-test-data.mjs && node scripts/generate-test-model.mjs",
    "generate:music": "node scripts/generate-music-fixtures.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release:pack": "node scripts/release.mjs pack",
    "check:packages": "node scripts/check-packages.mjs",
    "release:publish": "node scripts/release.mjs publish",
    "release:verify": "node scripts/release.mjs verify"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "@changesets/cli": "3.0.2"
  },
  "overrides": {
    "rehype-katex": {
      "katex": "0.18.7"
    }
  }
}
