---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import PostList from '@alkemdotdev/alkemist-components/post-list';
import type { ThemeStyle } from '@alkemdotdev/alkemist-theme';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  blogDisplay,
  enabledSections,
  sections,
  siteName,
  type SectionId,
  withBase,
} from '../../lib/site';

type DisplayEntry = {
  id: string;
  data: {
    title: string;
    description: string;
    published?: string;
    order?: number;
    cover?: {
      src: {
        src: string;
        width: number;
        height: number;
        format:
          | 'jpeg'
          | 'jpg'
          | 'png'
          | 'apng'
          | 'tiff'
          | 'webp'
          | 'gif'
          | 'svg'
          | 'avif';
      };
      alt: string;
      caption?: string;
      fit: 'cover' | 'contain';
      focalX: number;
      focalY: number;
      showInPost: boolean;
    };
  };
};
type SlideEntry = {
  id: string;
  data: {
    title: string;
    description: string;
    draft: boolean;
    theme: 'inherit' | ThemeStyle;
    transition: 'none' | 'fade' | 'slide';
    cover?: {
      src: {
        src: string;
        width: number;
        height: number;
        format:
          | 'jpeg'
          | 'jpg'
          | 'png'
          | 'apng'
          | 'tiff'
          | 'webp'
          | 'gif'
          | 'svg'
          | 'avif';
      };
      alt: string;
      fit: 'cover' | 'contain';
      focalX: number;
      focalY: number;
    };
  };
};
const descriptions: Record<SectionId, string> = {
  blog: 'Developed writing about the work and what it means.',
  logs: 'Quick notes from the workbench.',
  labs: 'Interactive, quick one-off apps you can use.',
  slides: 'Browser talks written in Markdown or MDX.',
  docs: 'Project reference for using and understanding the work.',
  book: 'A curated, ordered guide for getting started.',
  info: 'The people, purpose, and questions behind this project.',
};

export async function getStaticPaths() {
  return enabledSections.map((section) => ({ params: { section } }));
}

const section = Astro.params.section as SectionId;
const label = sections[section].label;
let entries: DisplayEntry[] = [];
if (section === 'blog')
  entries = await getCollection('blog', ({ data }) => !data.draft);
if (section === 'logs')
  entries = await getCollection('logs', ({ data }) => !data.draft);
if (section === 'docs')
  entries = await getCollection('docs', ({ data }) => !data.draft);
if (section === 'book')
  entries = await getCollection('book', ({ data }) => !data.draft);
const slideEntries: SlideEntry[] =
  section === 'slides'
    ? await getCollection('slides', ({ data }) => !data.draft)
    : [];
const logs =
  section === 'logs'
    ? await Promise.all(
        (await getCollection('logs', ({ data }) => !data.draft))
          .sort(
            (a, b) =>
              b.data.published.localeCompare(a.data.published) ||
              a.id.localeCompare(b.id),
          )
          .map(async (entry) => ({
            entry,
            Content: (await render(entry)).Content,
          })),
      )
    : [];
const orderedEntries = [...entries].sort((a, b) => {
  if (section === 'book')
    return (
      (a.data.order ?? 0) - (b.data.order ?? 0) || a.id.localeCompare(b.id)
    );
  return (
    (b.data.published ?? '').localeCompare(a.data.published ?? '') ||
    a.id.localeCompare(b.id)
  );
});
---

<SiteLayout title={label} description={descriptions[section]}>
  {
    section === 'info' ? (
      <div class="lab-reading">
        <h1>About {siteName}</h1>
        <p>
          This is a place for the questions we are asking and the things we are
          building.
        </p>
        <h2>People and purpose</h2>
        <p>
          Introduce your team, your research interests, and how others can
          participate.
        </p>
      </div>
    ) : section === 'labs' ? (
      <>
        <>
          <h1>{label}</h1>
          <p>{descriptions.labs}</p>
        </>
        <article class="lab-card lab-section">
          <h2>
            <a href={withBase('labs/oscillator/')}>The oscillator bench</a>
          </h2>
          <p>Inspect synthetic motion data and orbit a small 3D model.</p>
        </article>
      </>
    ) : section === 'logs' ? (
      <>
        <>
          <h1>{label}</h1>
          <p>{descriptions.logs}</p>
        </>
        {logs.map(({ entry, Content }) => (
          <article class="lab-card lab-section">
            <time class="alk-eyebrow" datetime={entry.data.published}>
              {entry.data.published}
            </time>
            <h2>
              <a href={withBase(`logs/${entry.id}/`)}>{entry.data.title}</a>
            </h2>
            <p>{entry.data.description}</p>
            <Content />
          </article>
        ))}
      </>
    ) : section === 'blog' ? (
      <>
        <h1>{label}</h1>
        <p>{descriptions.blog}</p>
        <PostList
          {...blogDisplay}
          items={orderedEntries.map((entry) => ({
            href: withBase(`blog/${entry.id}/`),
            title: entry.data.title,
            description: entry.data.description,
            date: entry.data.published,
            cover: entry.data.cover,
          }))}
        />
      </>
    ) : section === 'slides' ? (
      <>
        <h1>{label}</h1>
        <p>{descriptions.slides}</p>
        {slideEntries.map((entry) => (
          <article class="lab-card lab-section">
            {entry.data.cover && (
              <Image
                src={entry.data.cover.src}
                alt={entry.data.cover.alt}
                widths={[480, 800]}
                sizes="(max-width: 720px) calc(100vw - 2.5rem), 720px"
                format={entry.data.cover.src.format === 'svg' ? 'svg' : 'webp'}
                style={`object-fit:${entry.data.cover.fit};object-position:${entry.data.cover.focalX}% ${entry.data.cover.focalY}%;`}
              />
            )}
            <h2>
              <a href={withBase(`slides/${entry.id}/`)}>{entry.data.title}</a>
            </h2>
            <p>{entry.data.description}</p>
            <p class="alk-eyebrow">
              {entry.data.theme} theme · {entry.data.transition} transition
            </p>
          </article>
        ))}
      </>
    ) : (
      <>
        <>
          <h1>{label}</h1>
          <p>{descriptions[section]}</p>
        </>
        {orderedEntries.map((entry) => (
          <article class="lab-card lab-section">
            {entry.data.published && (
              <p class="alk-eyebrow">{entry.data.published}</p>
            )}
            {section === 'book' && (
              <p class="alk-eyebrow">Chapter {entry.data.order}</p>
            )}
            <h2>
              <a href={withBase(`${section}/${entry.id}/`)}>
                {entry.data.title}
              </a>
            </h2>
            <p>{entry.data.description}</p>
          </article>
        ))}
      </>
    )
  }
</SiteLayout>
