---
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  enabledSections,
  isSectionEnabled,
  sections,
  siteName,
  tagline,
  withBase,
} from '../lib/site';
---

<SiteLayout title={siteName} description={tagline}>
  <div class="lab-intro">
    <p class="alk-eyebrow">An open research notebook</p>
    <h1>Make an idea something you can explore.</h1>
    <p>
      {tagline}. This is your site: write about the work, share a usable
      experiment, and introduce the people behind it.
    </p>
    <p class="lab-note">Start with a question. Leave the working in.</p>
    <div class="lab-links">
      {
        isSectionEnabled('labs') && (
          <a href={withBase('labs/oscillator/')}>Explore the first lab →</a>
        )
      }
      {
        isSectionEnabled('blog') && (
          <a href={withBase('blog/first-experiment/')}>
            Read the first experiment
          </a>
        )
      }
    </div>
  </div>
  <section class="lab-grid lab-section" aria-label="Explore the site">
    {
      enabledSections.map((section) => (
        <article class="lab-card">
          <h2>{sections[section].label}</h2>
          <p>
            {section === 'blog'
              ? 'Developed writing about the work.'
              : section === 'logs'
                ? 'Quick notes from the workbench.'
                : section === 'labs'
                  ? 'Interactive, quick one-off apps.'
                  : section === 'docs'
                    ? 'Project reference.'
                    : section === 'book'
                      ? 'A curated, ordered guide.'
                      : 'The people, purpose, and questions behind this project.'}
          </p>
          <a href={withBase(`${section}/`)}>Open {sections[section].label} →</a>
        </article>
      ))
    }
  </section>
</SiteLayout>
